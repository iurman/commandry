[Unit]
Description=Commandry encrypted offsite PostgreSQL backup
Documentation=file:/opt/commandry/deploy/backup-and-restore.md
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/commandry-backup-gate nightly
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal

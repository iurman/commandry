# Illustration only. The provisional auth mode is disabled and other deployment gates remain open.
# The real file belongs at /etc/commandry/commandry.env with mode 0600.
# Replace every REPLACE value after approval. Image variables must be digests.
COMMANDRY_IMAGE=ghcr.io/OWNER/commandry@sha256:REPLACE_WITH_APPROVED_DIGEST
CADDY_IMAGE=docker.io/library/caddy@sha256:REPLACE_WITH_APPROVED_DIGEST
CLOUDFLARED_IMAGE=docker.io/cloudflare/cloudflared@sha256:REPLACE_WITH_APPROVED_DIGEST
APP_ORIGIN=https://commandry.site
DB_NAME=commandry
DB_ROOT_PASSWORD=REPLACE_WITH_SECRET
DB_APP_PASSWORD=REPLACE_WITH_SECRET
DB_MIGRATION_PASSWORD=REPLACE_WITH_SECRET
DATABASE_URL=postgresql://commandry_app:REPLACE_WITH_URI_ENCODED_SECRET@postgres:5432/commandry
DATABASE_MIGRATION_URL=postgresql://commandry_migrate:REPLACE_WITH_URI_ENCODED_SECRET@postgres:5432/commandry
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
APP_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
INITIAL_ADMIN_EMAIL=REPLACE_WITH_APPROVED_ADDRESS
PRODUCTION_AUTH_MODE=disabled
RELEASE_SHA=REPLACE_WITH_APPROVED_REVISION
RELEASE_BUILD_TIME=REPLACE_WITH_ISO_8601_UTC_TIME
PRODUCTION_DB_VOLUME_NAME=commandry-production-postgres
DB_POOL_MAX=5
BOSS_POOL_MAX=5

# Optional operator-reviewed catalogue, root-owned 0640 with group 1000, worker read-only.
# OBSERVATORY_ENDPOINT_CHECKS_FILE=

# Optional read-only Cloudflare metadata source for one explicitly authorized account.
# OBSERVATORY_CLOUDFLARE_ACCOUNT_ID=
# OBSERVATORY_CLOUDFLARE_TOKEN_FILE=

# Optional fixed Namecheap domain-list reader; API activation and IP allowance are separate owner decisions.
# OBSERVATORY_NAMECHEAP_USERNAME=
# OBSERVATORY_NAMECHEAP_KEY_FILE=
# OBSERVATORY_NAMECHEAP_CLIENT_IP=

# Optional canonical identity of this probing worker; permits evidence-backed check paths.
# OBSERVATORY_PROBE_ORIGIN_RESOURCE_ID=

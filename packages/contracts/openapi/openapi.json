          "status": {
            "type": "string",
            "enum": [
              "alive",
              "ready",
              "not_ready"
            ]
          },
          "service": {
            "type": "string",
            "const": "web"
          },
          "database": {
            "type": "string",
            "enum": [
              "ready",
              "unavailable"
            ]
          }
        },
        "required": [
          "status",
          "service"
        ],
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "CorrelationMetadata": {
        "type": "object",
        "properties": {
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "correlationId"
        ],
        "additionalProperties": false
      },
      "VersionResponse": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "minLength": 1
          },
          "imageDigest": {
            "type": [
              "string",
              "null"
            ]
          },
          "buildTime": {
            "type": [
              "string",
              "null"
            ]
          },
          "schemaCompatibility": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "enum": [
              "local",
              "test",
              "preview",
              "production"
            ]
          }
        },
        "required": [
          "sha",
          "imageDigest",
          "buildTime",
          "schemaCompatibility",
          "environment"
        ],
        "additionalProperties": false
      },
      "ResourceSummary": {

{
  "name": "@commandry/contracts",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi/openapi.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi:generate": "tsx src/generate-openapi.ts",
    "openapi:check": "tsx src/generate-openapi.ts --check && node src/validate-openapi.mjs",
    "check:generated": "pnpm openapi:check",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.mts packages/contracts/src"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0"
  }
}

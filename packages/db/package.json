{
  "name": "@commandry/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "test": "vitest run src"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.15",
    "@commandry/contracts": "workspace:*",
    "@commandry/domain": "workspace:*",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@commandry/application": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}

# Copying this file is not enough to start the stack. Run `pnpm setup` to create
# an ignored .env.local with random local-only database and application secrets.

# Optional Compose isolation for a second local worktree.
# COMPOSE_PROJECT_NAME=commandry-local
# DB_VOLUME_NAME=commandry-local-postgres
# WEB_HOST_PORT=3000
# DB_HOST_PORT=5432
# local or test. Preview and production startup are blocked until OQ-003 is decided.
APP_ENV=local
# Canonical local origin for links and Better Auth. URL, not secret.
APP_ORIGIN=http://127.0.0.1:3000
# Local database name. Text, not secret.
DB_NAME=commandry
# Generated local passwords. Never use these placeholder strings as credentials.
DB_ROOT_PASSWORD=<generated-local-root-password>
DB_APP_PASSWORD=<generated-local-app-password>
DB_MIGRATION_PASSWORD=<generated-local-migration-password>
# Host connections for local Node processes. URLs contain generated local secrets.
DATABASE_URL=postgresql://commandry_app:<generated-local-app-password>@127.0.0.1:5432/commandry
DATABASE_MIGRATION_URL=postgresql://commandry_migrate:<generated-local-migration-password>@127.0.0.1:5432/commandry
# Random 32-byte-or-longer local-only secret for Better Auth.
BETTER_AUTH_SECRET=<generated-local-auth-secret>
# Random 32-byte-or-longer local-only key reserved for encrypted records.
APP_ENCRYPTION_KEY=<generated-local-encryption-key>
# Leave empty until the first account and recovery method are explicitly decided.
INITIAL_ADMIN_EMAIL=
# Release metadata. `local` denotes an uncommitted development process.
RELEASE_SHA=local
RELEASE_IMAGE_DIGEST=
RELEASE_BUILD_TIME=
# Bounded connection pools, positive integers at most 20.
DB_POOL_MAX=5
BOSS_POOL_MAX=5
# Provisional local simulated-action policy. Sensitive actions still require approval.
LOCAL_APPROVAL_AUTO_CEILING=reversible
LOCAL_APPROVAL_TTL_SECONDS=3600
LOCAL_OVERNIGHT_MAX_DAYS=7
